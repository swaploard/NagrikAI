{
  "name": "NagrikAI",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",
  "features": {
    "ghcr.io/vaaaaanquish/ollama-feature:latest": {},
    "ghcr.io/jdx/mise:latest": {}
  },
  "postCreateCommand": "uv sync --dev",
  "forwardPorts": [7860, 11434],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "github.vscode-github-actions"
      ]
    }
  }
}
