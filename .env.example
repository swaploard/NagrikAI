# NagrikAI Environment Variables
# Copy to .env and fill in your values

# LLM Provider: ollama or openrouter
NAGRIKAI_LLM_PROVIDER=ollama

# OpenRouter Configuration (required when LLM_PROVIDER=openrouter)
NAGRIKAI_OPENROUTER_API_KEY=
NAGRIKAI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NAGRIKAI_OPENROUTER_MODEL=openrouter/auto

# Ollama Configuration (used when LLM_PROVIDER=ollama)
NAGRIKAI_OLLAMA_BASE_URL=http://localhost:11434
NAGRIKAI_OLLAMA_MODEL=qwen2.5:7b

NAGRIKAI_LANGSMITH_API_KEY=tes-api-key
# ChromaDB Persistence
NAGRIKAI_CHROMA_PERSIST_DIR=chroma_db

# Content Directory for crawled/parsed data
NAGRIKAI_CONTENT_DIR=content

# Tavily Configuration
NAGRIKAI_TAVILY_API_KEY=api-key

# Embedding Model
NAGRIKAI_EMBEDDING_MODEL=BAAI/bge-m3

# Text Chunking
NAGRIKAI_CHUNK_SIZE=800
NAGRIKAI_CHUNK_OVERLAP=200

# Retrieval Settings
NAGRIKAI_TOP_K=5
NAGRIKAI_FETCH_K=20
NAGRIKAI_LAMBDA_MULT=0.7

# Reranker (provider: local = sentence-transformers CrossEncoder, openrouter = OpenRouter rerank API)
# For OpenRouter: NAGRIKAI_RERANKER_PROVIDER=openrouter and NAGRIKAI_RERANKER_MODEL=cohere/rerank-4-pro
NAGRIKAI_RERANKER_PROVIDER=local
NAGRIKAI_RERANKER_MODEL=BAAI/bge-reranker-large
NAGRIKAI_RERANKER_ENABLED=true

# Hybrid Search (BM25 + Dense)
NAGRIKAI_HYBRID_SEARCH_ENABLED=true
NAGRIKAI_BM25_K1=1.5
NAGRIKAI_BM25_B=0.75

# Reciprocal Rank Fusion
NAGRIKAI_RRF_K=60